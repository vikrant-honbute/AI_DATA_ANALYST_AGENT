GROQ_API_KEY=your_groq_api_key
POSTGRES_URL=your_postgres_url
MONGODB_URL=mongodb://localhost:27017/ai_agent_memory

# PostgreSQL execution guardrails (optional)
POSTGRES_STATEMENT_TIMEOUT_MS=10000
POSTGRES_MAX_ROWS=1000
ALLOWED_POSTGRES_SCHEMAS=public

# CSV upload limits (optional)
MAX_CSV_BYTES=10485760
MAX_CSV_ROWS=100000
MAX_CSV_COLUMNS=200
